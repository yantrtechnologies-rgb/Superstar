generator client {
  provider        = "prisma-client-js"
  // Load includes with one JOIN query instead of one query per relation (each round trip to RDS costs ~0.3 s).
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  timeZone  String   @default("UTC") @map("time_zone")
  createdAt DateTime @default(now()) @map("created_at")

  memberships Membership[]
  invitations Invitation[]
  auditEvents AuditEvent[]

  clientGroups ClientGroup[]
  oauthStates OAuthState[]
  connectLinks ConnectLink[]
  creditAccount CreditAccount?
  creditPurchases CreditPurchase[]
  billingAccount BillingAccount?
  stripeEvents StripeEvent[]
  razorpaySubscription RazorpaySubscription?
  razorpayEvents RazorpayEvent[]
  aiJobs AiJob[]
  rssRules RssRule[]
  webhooks WebhookSubscription[]
  apiKeys ApiKey[]
  assets Asset[]
  channels Channel[]
  posts Post[]
  tags Tag[]
  signatures Signature[]
  postSets PostSet[]

  @@map("workspaces")
}

enum WorkspaceRole {
  OWNER
  ADMIN
  EDITOR
  REVIEWER
  VIEWER
}

model User {
  id            String       @id @default(uuid()) @db.Uuid
  name          String?
  email         String       @unique
  emailVerified DateTime?    @map("email_verified")
  image         String?
  passwordHash  String?      @map("password_hash")
  failedLogins  Int          @default(0) @map("failed_logins")
  lockedUntil   DateTime?    @map("locked_until")
  sessions      Session[]
  apiKeys       ApiKey[]
  oauthStates   OAuthState[]
  connectLinks  ConnectLink[]
  memberships   Membership[]
  sentInvites   Invitation[]
  auditEvents   AuditEvent[]
  accounts      Account[]

  @@map("users")
}

/// Sign-in identities from OAuth providers (Sign in with Google). Provider tokens are not kept.
model Account {
  id                String  @id @default(uuid()) @db.Uuid
  userId            String  @map("user_id") @db.Uuid
  type              String
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid()) @db.Uuid
  sessionToken String   @unique @map("session_token")
  userId       String   @db.Uuid @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Membership {
  workspaceId String        @map("workspace_id") @db.Uuid
  userId      String        @map("user_id") @db.Uuid
  role        WorkspaceRole
  createdAt   DateTime      @default(now()) @map("created_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([workspaceId, userId])
  @@index([userId])
  @@map("memberships")
}

model Invitation {
  id          String        @id @default(uuid()) @db.Uuid
  workspaceId String        @map("workspace_id") @db.Uuid
  invitedById String?       @map("invited_by_id") @db.Uuid
  email       String
  role        WorkspaceRole
  expiresAt   DateTime      @map("expires_at")
  acceptedAt  DateTime?     @map("accepted_at")
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  invitedBy   User?         @relation(fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([workspaceId, email])
  @@index([email, expiresAt])
  @@map("invitations")
}

model AuditEvent {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  actorId     String?   @map("actor_id") @db.Uuid
  action      String
  subjectId   String?   @map("subject_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  actor       User?     @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@map("audit_events")
}

enum PostState {
  DRAFT
  IN_REVIEW
  APPROVED
  SCHEDULED
  CANCELED
}

enum PublishState {
  SCHEDULED
  PUBLISHING
  PUBLISHED
  CANCELED
  FAILED
  UNCERTAIN
}

model Channel {
  id          String   @id @default(uuid()) @db.Uuid
  workspaceId String   @map("workspace_id") @db.Uuid
  provider    String
  externalId  String   @map("external_id")
  guildId     String?  @map("guild_id")
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  destinations Destination[]
  credential   ProviderCredential?
  clientGroupId String? @db.Uuid @map("client_group_id")
  clientGroup   ClientGroup? @relation(fields: [clientGroupId], references: [id], onDelete: SetNull)
  postingSlots  PostingSlot[]
  metricJobs    MetricJob[]

  @@unique([workspaceId, provider, externalId])
  @@map("channels")
}

model Post {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @map("workspace_id") @db.Uuid
  revision    Int       @default(1)
  state       PostState @default(DRAFT)
  createdAt   DateTime  @default(now()) @map("created_at")
  scheduledAt DateTime? @map("scheduled_at")
  createRequestKey String? @map("create_request_key")
  /// AI suggestions for the reviewer (why it matters, posting tips, other angles). Shown on the Posts page.
  aiNote      String?   @map("ai_note")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  reviewLinks ReviewLink[]
  editorialComments EditorialComment[]
  feedImports FeedImport[]
  aiJobs      AiJob[]
  revisions   PostRevision[]
  destinations Destination[]
  tags        PostTag[]
  /// Re-publish this post every N days after it goes out (null = once).
  repeatEveryDays Int? @map("repeat_every_days")
  /// The post this one repeats; each post spawns at most one next occurrence.
  repeatSourceId String? @unique @db.Uuid @map("repeat_source_id")

  @@unique([workspaceId, createRequestKey])
  @@index([workspaceId, scheduledAt])
  @@index([workspaceId, createdAt])
  @@map("posts")
}

model PostRevision {
  postId    String   @map("post_id") @db.Uuid
  number    Int
  channelIds String[] @default([]) @db.Uuid @map("channel_ids")
  content   String
  followUpText String? @map("follow_up_text")
  followUpDelayMinutes Int? @map("follow_up_delay_minutes")
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  approval  Approval?
  assetId   String? @db.Uuid @map("asset_id")
  asset     Asset? @relation(fields: [assetId], references: [id])
  /// Ordered media for the post; when empty, assetId (if any) is the only media.
  mediaIds  String[] @default([]) @db.Uuid @map("media_ids")
  /// Per-channel text that replaces content for that channel: { [channelId]: text }.
  overrides Json @default("{}")
  /// Follow-up thread items published as replies: [{ content, delayMinutes }].
  thread    Json @default("[]")

  @@id([postId, number])
  @@map("post_revisions")
}

model Approval {
  postId    String   @map("post_id") @db.Uuid
  revision  Int
  reviewerId String? @map("reviewer_id") @db.Uuid
  reviewLinkId String? @map("review_link_id") @db.Uuid
  reviewLink ReviewLink? @relation(fields: [reviewLinkId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now()) @map("created_at")
  version PostRevision @relation(fields: [postId, revision], references: [postId, number], onDelete: Cascade)

  @@id([postId, revision])
  @@map("approvals")
}

model Destination {
  id          String       @id @default(uuid()) @db.Uuid
  postId      String       @map("post_id") @db.Uuid
  channelId   String       @map("channel_id") @db.Uuid
  revision    Int
  state       PublishState @default(SCHEDULED)
  startedAt   DateTime?    @map("started_at")
  notBefore   DateTime?    @map("not_before")
  parentId    String?      @unique @db.Uuid @map("parent_id")
  /// 0 for the main post; 1..n for thread items published as replies.
  threadIndex Int          @default(0) @map("thread_index")
  parent      Destination? @relation("DestinationFollowUp", fields: [parentId], references: [id], onDelete: Cascade)
  followUp    Destination? @relation("DestinationFollowUp")
  externalId  String?      @map("external_id")
  permalink   String?
  error       String?
  post        Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  channel     Channel      @relation(fields: [channelId], references: [id], onDelete: NoAction)
  outbox      OutboxEvent?
  attempts    PublishAttempt[]

  @@index([postId, revision])
  @@index([state, startedAt])
  @@map("destinations")
}

model PublishAttempt {
  id            String       @id @default(uuid()) @db.Uuid
  destinationId String       @map("destination_id") @db.Uuid
  number        Int
  state         PublishState
  startedAt     DateTime     @default(now()) @map("started_at")
  finishedAt    DateTime?    @map("finished_at")
  error         String?
  destination   Destination  @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@unique([destinationId, number])
  @@map("publish_attempts")
}

model OutboxEvent {
  destinationId String      @id @map("destination_id") @db.Uuid
  dueAt         DateTime    @map("due_at")
  dispatchedAt  DateTime?   @map("dispatched_at")
  destination   Destination @relation(fields: [destinationId], references: [id], onDelete: Cascade)

  @@index([dispatchedAt, dueAt])
  @@map("outbox_events")
}

model Asset {
  id          String         @id @default(uuid()) @db.Uuid
  workspaceId String         @db.Uuid @map("workspace_id")
  key         String         @unique
  type        String
  size        Int
  checksum    String
  label       String?
  alt         String?
  archivedAt  DateTime?      @map("archived_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  workspace   Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  aiJobs      AiJob[] @relation("StudioOutput")
  sourceJobs  AiJob[] @relation("StudioSource")
  revisions   PostRevision[]

  @@index([workspaceId])
  @@map("assets")
}

model OAuthState {
  payload     String?
  hash        String    @id
  userId      String    @db.Uuid @map("user_id")
  workspaceId String    @db.Uuid @map("workspace_id")
  provider    String
  expiresAt   DateTime  @map("expires_at")
  // Set when a client started this connection from an agency's connect link (no Superstar session).
  connectLinkHash String? @map("connect_link_hash")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  connectLink ConnectLink? @relation(fields: [connectLinkHash], references: [hash], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([connectLinkHash, expiresAt])
  @@map("oauth_states")
}

// A link an agency sends to a client so the client can connect their own account to the agency's workspace
// without a Superstar account. The client signs in on the network; the connection runs as the link's creator.
model ConnectLink {
  hash        String    @id
  token       String
  workspaceId String    @db.Uuid @map("workspace_id")
  createdById String    @db.Uuid @map("created_by_id")
  provider    String
  label       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  lastUsedAt  DateTime? @map("last_used_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User      @relation(fields: [createdById], references: [id], onDelete: Cascade)
  oauthStates OAuthState[]

  @@index([workspaceId, expiresAt])
  @@map("connect_links")
}

model ProviderCredential {
  channelId        String    @id @db.Uuid @map("channel_id")
  accessToken      String    @map("access_token")
  accessExpiresAt  DateTime  @map("access_expires_at")
  refreshToken     String?   @map("refresh_token")
  refreshExpiresAt DateTime? @map("refresh_expires_at")
  revokedAt        DateTime? @map("revoked_at")
  channel          Channel   @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@map("provider_credentials")
}

model ReviewLink {
  id        String    @id @default(uuid()) @db.Uuid
  postId    String    @db.Uuid @map("post_id")
  revision  Int
  hash      String    @unique
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  approvals Approval[]
  comments  EditorialComment[]

  @@index([postId, revision])
  @@map("review_links")
}

model EditorialComment {
  id           String    @id @default(uuid()) @db.Uuid
  postId       String    @db.Uuid @map("post_id")
  revision     Int
  reviewLinkId String    @db.Uuid @map("review_link_id")
  action       String
  body         String
  createdAt    DateTime  @default(now()) @map("created_at")
  post         Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  reviewLink   ReviewLink @relation(fields: [reviewLinkId], references: [id], onDelete: Cascade)

  @@index([postId, revision, createdAt])
  @@map("editorial_comments")
}

model ClientGroup {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  name        String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  channels    Channel[]

  @@unique([workspaceId, name])
  @@map("client_groups")
}

model PostingSlot {
  id        String  @id @default(uuid()) @db.Uuid
  channelId String  @db.Uuid @map("channel_id")
  weekday   Int
  minute    Int
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, weekday, minute])
  @@map("posting_slots")
}

enum MetricJobState {
  QUEUED
  COLLECTED
  UNAVAILABLE
}

model MetricJob {
  id            String         @id @default(uuid()) @db.Uuid
  channelId     String         @db.Uuid @map("channel_id")
  bucket        DateTime
  dispatchedAt  DateTime?      @map("dispatched_at")
  state         MetricJobState @default(QUEUED)
  error         String?
  channel       Channel        @relation(fields: [channelId], references: [id], onDelete: Cascade)
  snapshot      MetricsSnapshot?

  @@unique([channelId, bucket])
  @@index([dispatchedAt, bucket])
  @@map("metric_jobs")
}

model MetricsSnapshot {
  id         String    @id @default(uuid()) @db.Uuid
  jobId      String    @unique @db.Uuid @map("job_id")
  count      Int
  observedAt DateTime  @default(now()) @map("observed_at")
  job        MetricJob @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@map("metrics_snapshots")
}

enum AiKind {
  TEXT
  IMAGE
  CLIP
  TRANSCRIBE
  VIDEO
}

enum AiJobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELED
}

enum CreditEntryKind {
  GRANT
  RESERVE
  CAPTURE
  REFUND
  PURCHASE
}

model CreditAccount {
  workspaceId String    @id @db.Uuid @map("workspace_id")
  available   Int       @default(0)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  entries     CreditEntry[]

  @@map("credit_accounts")
}

model CreditEntry {
  id          String          @id @default(uuid()) @db.Uuid
  workspaceId String          @db.Uuid @map("workspace_id")
  kind        CreditEntryKind
  delta       Int
  reference   String          @unique
  createdAt   DateTime        @default(now()) @map("created_at")
  account     CreditAccount   @relation(fields: [workspaceId], references: [workspaceId], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("credit_ledger")
}

model AiJob {
  id          String      @id @default(uuid()) @db.Uuid
  workspaceId String      @db.Uuid @map("workspace_id")
  requestId   String      @db.Uuid @map("request_id")
  kind        AiKind
  state       AiJobState  @default(QUEUED)
  prompt      String
  model       String
  credits     Int
  outputText  String?     @map("output_text")
  assetId     String?     @db.Uuid @map("asset_id")
  sourceAssetId String?   @db.Uuid @map("source_asset_id")
  startSecond Int? @map("start_second")
  durationSeconds Int? @map("duration_seconds")
  providerRef String?     @map("provider_ref")
  error       String?
  dispatchedAt DateTime?  @map("dispatched_at")
  startedAt   DateTime?   @map("started_at")
  finishedAt  DateTime?   @map("finished_at")
  createdAt   DateTime    @default(now()) @map("created_at")
  workspace   Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  asset       Asset?      @relation("StudioOutput", fields: [assetId], references: [id], onDelete: SetNull)

  sourceAsset Asset? @relation("StudioSource", fields: [sourceAssetId], references: [id], onDelete: SetNull)
  /// When set, the generated image or video is attached to this post (if it is still a draft or awaiting approval).
  postId      String?     @db.Uuid @map("post_id")
  post        Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@unique([workspaceId, requestId])
  @@index([workspaceId, createdAt])
  @@index([dispatchedAt, createdAt])
  @@index([state, startedAt])
  @@index([postId])
  @@map("ai_jobs")
}

enum RssRunState {
  QUEUED
  COMPLETED
  FAILED
  SKIPPED
}

model RssRule {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  name        String
  sourceUrl   String    @map("source_url")
  enabled     Boolean   @default(true)
  nextRunAt   DateTime  @default(now()) @map("next_run_at")
  publishAfterApproval Boolean @default(false) @map("publish_after_approval")
  channelIds String[] @default([]) @db.Uuid @map("channel_ids")
  authorizedById String? @db.Uuid @map("authorized_by_id")
  /// When set, each new item goes through AI: kept only if it fits this topic, then rewritten as a post.
  aiTopic     String?   @map("ai_topic")
  /// Brand, audience and tone guidance for the AI writer.
  aiInstructions String? @map("ai_instructions")
  /// Also generate a matching image for each AI post.
  aiImage     Boolean   @default(false) @map("ai_image")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  runs        RssRun[]
  imports     FeedImport[]

  @@unique([workspaceId, sourceUrl])
  @@index([enabled, nextRunAt])
  @@map("rss_rules")
}

model RssRun {
  id          String      @id @default(uuid()) @db.Uuid
  ruleId      String      @db.Uuid @map("rule_id")
  bucket      DateTime
  state       RssRunState @default(QUEUED)
  imported    Int         @default(0)
  error       String?
  createdAt   DateTime    @default(now()) @map("created_at")
  dispatchedAt DateTime?  @map("dispatched_at")
  rule        RssRule     @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, bucket])
  @@index([dispatchedAt, createdAt])
  @@map("rss_runs")
}

enum RssScheduleState {
  OFF
  WAITING_REVIEW
  BLOCKED
  SCHEDULED
}

model FeedImport {
  ruleId      String   @db.Uuid @map("rule_id")
  sourceKey   String   @map("source_key")
  postId      String?  @db.Uuid @map("post_id")
  scheduleState RssScheduleState @default(OFF) @map("schedule_state")
  scheduleError String? @map("schedule_error")
  nextScheduleAt DateTime @default(now()) @map("next_schedule_at")
  importedAt DateTime @default(now()) @map("imported_at")
  /// AI rules only: PENDING, DONE, SKIPPED (not on topic or older item) or FAILED.
  aiState     String?  @map("ai_state")
  aiNote      String?  @map("ai_note")
  /// When an AI run claimed this item; only one run works on an item at a time (stale claims expire after 10 min).
  aiClaimedAt DateTime? @map("ai_claimed_at")
  title       String?
  /// The item text, kept until the AI writer has used it.
  sourceText  String?  @map("source_text")
  rule        RssRule  @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  post        Post?    @relation(fields: [postId], references: [id], onDelete: SetNull)

  @@id([ruleId, sourceKey])
  @@index([scheduleState, nextScheduleAt])
  @@map("feed_items")
}

enum WebhookDeliveryState {
  QUEUED
  SENDING
  DELIVERED
  FAILED
  SKIPPED
}

model WebhookSubscription {
  id            String            @id @default(uuid()) @db.Uuid
  workspaceId   String            @db.Uuid @map("workspace_id")
  name          String
  endpoint      String
  signingSecret String            @map("signing_secret")
  enabled       Boolean           @default(true)
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  deliveries    WebhookDelivery[]

  @@unique([workspaceId, endpoint])
  @@map("webhook_subscriptions")
}

model WebhookDelivery {
  id             String               @id @default(uuid()) @db.Uuid
  subscriptionId String               @db.Uuid @map("subscription_id")
  eventId        String               @db.Uuid @map("event_id")
  body           String
  state          WebhookDeliveryState @default(QUEUED)
  attemptsCount  Int                  @default(0) @map("attempts_count")
  nextAttemptAt  DateTime             @default(now()) @map("next_attempt_at")
  leasedUntil    DateTime?            @map("leased_until")
  dispatchedAt   DateTime?            @map("dispatched_at")
  createdAt      DateTime             @default(now()) @map("created_at")
  statusCode     Int?                 @map("status_code")
  error          String?
  subscription   WebhookSubscription  @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  attempts       WebhookAttempt[]

  @@unique([subscriptionId, eventId])
  @@index([state, dispatchedAt, nextAttemptAt])
  @@map("webhook_deliveries")
}

model WebhookAttempt {
  id          String               @id @default(uuid()) @db.Uuid
  deliveryId  String               @db.Uuid @map("delivery_id")
  number      Int
  state       WebhookDeliveryState
  statusCode  Int?                 @map("status_code")
  error       String?
  startedAt   DateTime             @default(now()) @map("started_at")
  finishedAt  DateTime?            @map("finished_at")
  delivery    WebhookDelivery      @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, number])
  @@map("webhook_attempts")
}

model ApiKey {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  createdById String    @db.Uuid @map("created_by_id")
  name        String
  prefix      String
  tokenHash   String    @unique @map("token_hash")
  scopes      String[]
  createdAt   DateTime  @default(now()) @map("created_at")
  expiresAt   DateTime  @map("expires_at")
  revokedAt   DateTime? @map("revoked_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  creator     User      @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("api_keys")
}

model BillingAccount {
  workspaceId String @id @db.Uuid @map("workspace_id")
  stripeCustomerId String @unique @map("stripe_customer_id")
  stripeSubscriptionId String? @unique @map("stripe_subscription_id")
  priceId String? @map("price_id")
  status String?
  periodEnd DateTime? @map("period_end")
  cancelAtPeriodEnd Boolean @default(false) @map("cancel_at_period_end")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("billing_accounts")
}

model StripeEvent {
  id String @id
  type String
  workspaceId String @map("workspace_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("stripe_events")
}

model RazorpaySubscription {
  workspaceId String @id @db.Uuid @map("workspace_id")
  subscriptionId String @unique @map("razorpay_subscription_id")
  planId String @map("plan_id")
  status String
  shortUrl String? @map("short_url")
  currentEnd DateTime? @map("current_end")
  cancelAtCycleEnd Boolean @default(false) @map("cancel_at_cycle_end")
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("razorpay_subscriptions")
}

model RazorpayEvent {
  id String @id
  type String
  workspaceId String @map("workspace_id") @db.Uuid
  processedAt DateTime @default(now()) @map("processed_at")
  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("razorpay_events")
}

model Tag {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  name        String
  color       String
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  posts       PostTag[]

  @@unique([workspaceId, name])
  @@map("tags")
}

model PostTag {
  postId String @db.Uuid @map("post_id")
  tagId  String @db.Uuid @map("tag_id")
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([postId, tagId])
  @@index([tagId])
  @@map("post_tags")
}

model Signature {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  name        String
  content     String
  isDefault   Boolean   @default(false) @map("is_default")
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
  @@map("signatures")
}

/// A saved composer preset: channels, text, thread, tags and repeat.
model PostSet {
  id          String    @id @default(uuid()) @db.Uuid
  workspaceId String    @db.Uuid @map("workspace_id")
  name        String
  data        Json
  createdAt   DateTime  @default(now()) @map("created_at")
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, name])
  @@map("post_sets")
}

/// A one-time AI credit pack bought through a Razorpay payment link. Credits are granted once, when paid.
model CreditPurchase {
  id            String    @id @default(uuid()) @db.Uuid
  workspaceId   String    @map("workspace_id") @db.Uuid
  userId        String?   @map("user_id") @db.Uuid
  pack          String
  credits       Int
  amountPaise   Int       @map("amount_paise")
  paymentLinkId String?   @unique @map("payment_link_id")
  shortUrl      String?   @map("short_url")
  status        String    @default("created")
  paymentId     String?   @map("payment_id")
  createdAt     DateTime  @default(now()) @map("created_at")
  paidAt        DateTime? @map("paid_at")
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId, createdAt])
  @@map("credit_purchases")
}