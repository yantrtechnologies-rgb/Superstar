generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Workspace {
  id        String   @id @default(uuid()) @db.Uuid
  slug      String   @unique
  name      String
  timeZone  String   @default("UTC") @map("time_zone")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("workspaces")
}
