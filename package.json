{
  "name": "cadencedesk",
  "private": true,
  "packageManager": "pnpm@10.10.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test scripts/*.test.mjs",
    "db:generate": "pnpm --filter @cadencedesk/data generate",
    "db:migrate": "pnpm --filter @cadencedesk/data migrate"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.0.0",
    "eslint": "^9.39.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0"
  }
}
